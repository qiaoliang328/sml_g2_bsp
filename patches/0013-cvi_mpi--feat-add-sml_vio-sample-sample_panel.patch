diff --git a/sample_app/sml_vio/Makefile b/sample_app/sml_vio/Makefile
new file mode 100644
index 0000000..54a653c
--- /dev/null
+++ b/sample_app/sml_vio/Makefile
@@ -0,0 +1,63 @@
+SHELL = /bin/bash
+ifeq ($(PARAM_FILE), )
+	PARAM_FILE:=../../Makefile.param
+	include $(PARAM_FILE)
+endif
+
+COMMON_DIR ?= $(PWD)/../common
+COMM_SRC := $(wildcard $(COMMON_DIR)/*.c)
+COMM_OBJ := $(COMM_SRC:%.c=%.o)
+COMM_INC := $(COMMON_DIR)
+COMM_DEPS = $(COMM_SRC:.c=.d)
+
+SDIR = $(PWD)
+SRCS = $(wildcard $(SDIR)/*.c)
+INCS = -I$(MW_INC) -I$(COMM_INC) -I$(ISP_INC) -I$(MW_INC)/sensor -I./inc
+OBJS = $(SRCS:.c=.o)
+DEPS = $(SRCS:.c=.d)
+
+TARGET = sample_sml_vio
+ifeq ($(CONFIG_ENABLE_SDK_ASAN), y)
+TARGET = sample_sml_vio_asan
+endif
+
+PKG_CONFIG_PATH = $(MW_PATH)/pkgconfig
+REQUIRES = cvi_common cvi_sample
+
+ifeq ($(CONFIG_ENABLE_SDK_ASAN), y)
+PKG_CONFIG_PATH = $(MW_PATH)/pkgconfig
+REQUIRES = cvi_common
+LIBS = $(shell PKG_CONFIG_PATH=$(PKG_CONFIG_PATH) pkg-config --libs --define-variable=mw_dir=$(MW_PATH) cvi_common)
+else
+ELFFLAGS += -static
+LIBS = -lvi -lvpss -lvenc -lrgn -lvo -lmipi -lsys -lsensor -lcvi_bin -lisp -lawb -lae -laf
+ifneq ($(OS_TYPE), DUAL_OS)
+LIBS += -lsns_full -lsensor $(ISP_LIB) -lisp -lawb -lae -laf -lisp_algo -lcvi_bin
+endif
+endif
+
+EXTRA_CFLAGS = $(INCS) $(DEFS)
+EXTRA_LDFLAGS = $(LIBS) -lpthread -lm -lini
+
+
+.PHONY : clean all
+all: $(TARGET)
+
+$(COMMON_DIR)/%.o: $(COMMON_DIR)/%.c
+	@$(CC) $(DEPFLAGS) $(CFLAGS) $(EXTRA_CFLAGS) -o $@ -c $<
+	@echo [$(notdir $(CC))] $(notdir $@)
+
+$(SDIR)/%.o: $(SDIR)/%.c
+	@$(CC) $(DEPFLAGS) $(CFLAGS) $(EXTRA_CFLAGS) -o $@ -c $<
+	@echo [$(notdir $(CC))] $(notdir $@)
+
+
+$(TARGET): $(COMM_OBJ) $(OBJS)
+	@$(CXX) -o $@ $(OBJS) $(COMM_OBJ) $(ELFFLAGS) $(EXTRA_LDFLAGS)
+	@echo -e $(BLUE)[LINK]$(END)[$(notdir $(CXX))] $(notdir $@)
+
+clean:
+	@rm -f $(OBJS) $(DEPS) $(COMM_OBJ) $(COMM_DEPS) $(TARGET)
+	@echo $(OBJS) "1" $(DEPS) "2" $(COMM_OBJ) "3" $(COMM_DEPS) "4" $(TARGET)
+
+-include $(DEPS) $(COMM_DEPS)
diff --git a/sample_app/sml_vio/sample_sml_vio.c b/sample_app/sml_vio/sample_sml_vio.c
new file mode 100644
index 0000000..8758e50
--- /dev/null
+++ b/sample_app/sml_vio/sample_sml_vio.c
@@ -0,0 +1,418 @@
+#include <signal.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "cvi_comm_cif.h"
+#include "cvi_comm_sns.h"
+#include "cvi_comm_vb.h"
+#include "cvi_comm_vpss.h"
+#include "cvi_mipi.h"
+#include "cvi_sns_ctrl.h"
+#include "cvi_vo.h"
+#include "sample_comm.h"
+
+static SNS_INI_CFG_S gstSnsIniCfg;
+
+static CVI_VOID SAMPLE_SML_VIO_WAIT_EXIT(CVI_VOID)
+{
+    char input[64] = { 0 };
+
+    while (1) {
+        SAMPLE_PRT("input 'exit' to quit:\n");
+        if (fgets(input, sizeof(input), stdin) == NULL) {
+            clearerr(stdin);
+            continue;
+        }
+        input[strcspn(input, "\n")] = '\0';
+        if (strcmp(input, "exit") == 0)
+            break;
+    }
+}
+
+static CVI_S32 SAMPLE_SML_VIO_SET_FIX_VB(VB_CONFIG_S* pstVbConfig)
+{
+    CVI_U32 u32BlkSize;
+
+    memset(pstVbConfig, 0, sizeof(*pstVbConfig));
+
+    u32BlkSize = COMMON_GetPicBufferSize(2560, 1920, VI_PIXEL_FORMAT, DATA_BITWIDTH_8,
+        COMPRESS_MODE_NONE, DEFAULT_ALIGN);
+    pstVbConfig->astCommPool[0].u32BlkSize = u32BlkSize;
+    pstVbConfig->astCommPool[0].u32BlkCnt = 3;
+    pstVbConfig->astCommPool[0].enRemapMode = VB_REMAP_MODE_CACHED;
+
+    u32BlkSize = COMMON_GetPicBufferSize(320, 256, PIXEL_FORMAT_NV21, DATA_BITWIDTH_8,
+        COMPRESS_MODE_NONE, DEFAULT_ALIGN);
+    pstVbConfig->astCommPool[1].u32BlkSize = u32BlkSize;
+    pstVbConfig->astCommPool[1].u32BlkCnt = 4;
+    pstVbConfig->astCommPool[1].enRemapMode = VB_REMAP_MODE_CACHED;
+
+    pstVbConfig->u32MaxPoolCnt = 2;
+
+    SAMPLE_PRT("[INFO] fixed VB pool0: 2560x1920 cnt=4 size=%u\n",
+        pstVbConfig->astCommPool[0].u32BlkSize);
+    SAMPLE_PRT("[INFO] fixed VB pool1: 320x240 cnt=4 size=%u\n",
+        pstVbConfig->astCommPool[1].u32BlkSize);
+
+    return CVI_SUCCESS;
+}
+
+static CVI_S32 SAMPLE_SML_VIO_SYS_INIT(SAMPLE_VI_CONFIG_S* pstViConfig,
+    SNS_INI_CFG_S* pstSnsIniCfg,
+    VB_CONFIG_S* pstVbConfig)
+{
+    CVI_S32 s32Ret;
+    VB_CONFIG_S stIniVbConfig;
+
+    s32Ret = CVI_SYS_Init();
+    if (s32Ret != CVI_SUCCESS) {
+        SAMPLE_PRT("[ERROR] CVI_SYS_Init failed: %#x\n", s32Ret);
+        return s32Ret;
+    }
+
+    memset(&stIniVbConfig, 0, sizeof(stIniVbConfig));
+    s32Ret = SAMPLE_COMM_VI_INI_INIT(pstViConfig, pstSnsIniCfg, &stIniVbConfig);
+    if (s32Ret != CVI_SUCCESS) {
+        SAMPLE_PRT("SAMPLE_COMM_VI_INI_INIT failed: %#x\n", s32Ret);
+        return s32Ret;
+    }
+    memcpy(&gstSnsIniCfg, pstSnsIniCfg, sizeof(gstSnsIniCfg));
+
+    s32Ret = SAMPLE_SML_VIO_SET_FIX_VB(pstVbConfig);
+    if (s32Ret != CVI_SUCCESS)
+        return s32Ret;
+
+    s32Ret = SAMPLE_COMM_SYS_Init(pstVbConfig);
+    if (s32Ret != CVI_SUCCESS) {
+        SAMPLE_PRT("SAMPLE_COMM_SYS_Init failed: %#x\n", s32Ret);
+        return s32Ret;
+    }
+
+    return CVI_SUCCESS;
+}
+
+static CVI_S32 SAMPLE_SML_VIO_SET_VI_VPSS_MODE(VI_VPSS_MODE_E vivpssMode)
+{
+    CVI_S32 s32Ret;
+    VI_VPSS_MODE_S stVIVPSSMode;
+    VPSS_MODE_S stVPSSMode;
+
+    stVIVPSSMode.aenMode[0] = stVIVPSSMode.aenMode[1] = vivpssMode;
+
+    stVPSSMode.enMode = VPSS_MODE_DUAL;
+    stVPSSMode.aenInput[0] = VPSS_INPUT_MEM;
+    if (vivpssMode == VI_OFFLINE_VPSS_ONLINE
+        || vivpssMode == VI_ONLINE_VPSS_ONLINE
+        || vivpssMode == VI_SLICE_VPSS_ONLINE) {
+        stVPSSMode.aenInput[1] = VPSS_INPUT_ISP;
+    } else {
+        stVPSSMode.aenInput[1] = VPSS_INPUT_MEM;
+    }
+
+    s32Ret = CVI_SYS_SetVIVPSSMode(&stVIVPSSMode);
+    if (s32Ret != CVI_SUCCESS) {
+        SAMPLE_PRT("CVI_SYS_SetVIVPSSMode failed: %#x\n", s32Ret);
+        return s32Ret;
+    }
+
+    s32Ret = CVI_VPSS_SetMode(&stVPSSMode);
+    if (s32Ret != CVI_SUCCESS) {
+        SAMPLE_PRT("CVI_VPSS_SetMode failed: %#x\n", s32Ret);
+        return s32Ret;
+    }
+
+    return CVI_SUCCESS;
+}
+
+static CVI_S32 SAMPLE_SML_VIO_VI_INIT(SAMPLE_VI_CONFIG_S* pstViConfig)
+{
+    CVI_S32 s32Ret;
+    CVI_S32 i;
+
+    SAMPLE_COMM_VI_StartMIPI(pstViConfig);
+
+    for (i = 0; i < gstSnsIniCfg.devNum; i++) {
+        if (!pstViConfig->astViInfo->stDevInfo.bPatgen) {
+            if (CVI_SNS_SetSnsProbe(i) != CVI_SUCCESS) {
+                SAMPLE_PRT("[ERROR] sensor_%d probe failed\n", i);
+                return CVI_FAILURE;
+            }
+        }
+    }
+
+    for (i = 0; i < pstViConfig->s32ViNum; i++) {
+        s32Ret = SAMPLE_COMM_VI_StartDev(&pstViConfig->astViInfo[i]);
+        if (s32Ret != CVI_SUCCESS)
+            return s32Ret;
+    }
+
+    for (i = 0; i < pstViConfig->s32ViNum; i++) {
+        s32Ret = SAMPLE_COMM_VI_StartPipe(&pstViConfig->astViInfo[i]);
+        if (s32Ret != CVI_SUCCESS)
+            return s32Ret;
+    }
+
+    s32Ret = SAMPLE_COMM_VI_CreateIsp(pstViConfig);
+    if (s32Ret != CVI_SUCCESS)
+        return s32Ret;
+
+    for (i = 0; i < gstSnsIniCfg.devNum; i++) {
+        if (!pstViConfig->astViInfo->stDevInfo.bPatgen) {
+            if (CVI_SNS_SetSnsInit(i) != CVI_SUCCESS) {
+                SAMPLE_PRT("[ERROR] sensor_%d init failed\n", i);
+                return CVI_FAILURE;
+            }
+        }
+    }
+
+    for (i = 0; i < pstViConfig->s32ViNum; i++) {
+        s32Ret = SAMPLE_COMM_VI_StartChn(&pstViConfig->astViInfo[i]);
+        if (s32Ret != CVI_SUCCESS)
+            return s32Ret;
+    }
+
+    return CVI_SUCCESS;
+}
+
+static CVI_S32 SAMPLE_SML_VIO_VI_DEINIT(SAMPLE_VI_CONFIG_S* pstViConfig)
+{
+    CVI_S32 s32Ret;
+    int i;
+
+    s32Ret = SAMPLE_COMM_VI_DestroyIsp(pstViConfig);
+    if (s32Ret != CVI_SUCCESS)
+        return s32Ret;
+
+    for (i = 0; i < pstViConfig->s32ViNum; i++) {
+        s32Ret = SAMPLE_COMM_VI_StopChn(&pstViConfig->astViInfo[i]);
+        if (s32Ret != CVI_SUCCESS)
+            return s32Ret;
+    }
+
+    for (i = 0; i < pstViConfig->s32ViNum; i++) {
+        s32Ret = SAMPLE_COMM_VI_StopPipe(&pstViConfig->astViInfo[i]);
+        if (s32Ret != CVI_SUCCESS)
+            return s32Ret;
+    }
+
+    for (i = 0; i < pstViConfig->s32ViNum; i++) {
+        s32Ret = SAMPLE_COMM_VI_StopDev(&pstViConfig->astViInfo[i]);
+        if (s32Ret != CVI_SUCCESS)
+            return s32Ret;
+    }
+
+    return CVI_SUCCESS;
+}
+
+static CVI_S32 SAMPLE_SML_VIO_VPSS_INIT(SAMPLE_VI_CONFIG_S* pstViConfig)
+{
+    CVI_S32 i;
+    CVI_S32 s32Ret;
+    VPSS_GRP_ATTR_S stVpssGrpAttr;
+    VPSS_CHN_ATTR_S stChnAttr;
+
+    for (i = 0; i < pstViConfig->s32ViNum; i++) {
+        SAMPLE_VI_INFO_S* pstViInfo = &pstViConfig->astViInfo[i];
+
+        memset(&stVpssGrpAttr, 0, sizeof(stVpssGrpAttr));
+        stVpssGrpAttr.stFrameRate.s32SrcFrameRate = -1;
+        stVpssGrpAttr.stFrameRate.s32DstFrameRate = -1;
+        stVpssGrpAttr.enPixelFormat = PIXEL_FORMAT_NV12;
+        stVpssGrpAttr.u32MaxW = pstViInfo->stDevInfo.stSize.u32Width;
+        stVpssGrpAttr.u32MaxH = pstViInfo->stDevInfo.stSize.u32Height;
+        stVpssGrpAttr.u8VpssDev = 1;
+
+        s32Ret = CVI_VPSS_CreateGrp(i, &stVpssGrpAttr);
+        if (s32Ret != CVI_SUCCESS)
+            goto fail;
+
+        memset(&stChnAttr, 0, sizeof(stChnAttr));
+        stChnAttr.u32Width = 1920;
+        stChnAttr.u32Height = 2560;
+        stChnAttr.enVideoFormat = VIDEO_FORMAT_LINEAR;
+        stChnAttr.enPixelFormat = PIXEL_FORMAT_NV21;
+        stChnAttr.stFrameRate.s32SrcFrameRate = 30;
+        stChnAttr.stFrameRate.s32DstFrameRate = 30;
+        stChnAttr.stAspectRatio.enMode = ASPECT_RATIO_NONE;
+
+        s32Ret = CVI_VPSS_SetChnAttr(i, 0, &stChnAttr);
+        if (s32Ret != CVI_SUCCESS)
+            goto fail;
+        s32Ret = CVI_VPSS_EnableChn(i, 0);
+        if (s32Ret != CVI_SUCCESS)
+            goto fail;
+        s32Ret = CVI_VPSS_SetChnRotation(i, 0, ROTATION_90);
+        if (s32Ret != CVI_SUCCESS)
+            goto fail;
+
+        stChnAttr.u32Width = 320;
+        stChnAttr.u32Height = 240;
+        s32Ret = CVI_VPSS_SetChnAttr(i, 1, &stChnAttr);
+        if (s32Ret != CVI_SUCCESS)
+            goto fail;
+        s32Ret = CVI_VPSS_EnableChn(i, 1);
+        if (s32Ret != CVI_SUCCESS)
+            goto fail;
+
+        s32Ret = CVI_VPSS_StartGrp(i);
+        if (s32Ret != CVI_SUCCESS)
+            goto fail;
+    }
+
+    return CVI_SUCCESS;
+
+fail:
+    for (i = 0; i < pstViConfig->s32ViNum; i++) {
+        CVI_VPSS_StopGrp(i);
+        CVI_VPSS_DisableChn(i, 0);
+        CVI_VPSS_DisableChn(i, 1);
+        CVI_VPSS_DestroyGrp(i);
+    }
+    return s32Ret;
+}
+
+static CVI_S32 SAMPLE_SML_VIO_VO_INIT(SAMPLE_VO_CONFIG_S* stVoConfig,
+    VO_DEV VoDev)
+{
+    CVI_S32 s32Ret;
+    RECT_S stDefDispRect;
+    SIZE_S stDefImageSize;
+    VO_SYNC_INFO_S st7789V3SyncInfo = {
+        .bSynm = 1,
+        .bIop = 1,
+        .u16FrameRate = 60,
+        .u16Vact = 320,
+        .u16Vbb = 4,
+        .u16Vfb = 8,
+        .u16Hact = 240,
+        .u16Hbb = 10,
+        .u16Hfb = 38,
+        .u16Vpw = 4,
+        .u16Hpw = 10,
+        .bIdv = 0,
+        .bIhs = 1,
+        .bIvs = 1,
+    };
+
+    stDefDispRect.s32X = 0;
+    stDefDispRect.s32Y = 0;
+    stDefDispRect.u32Width = 240;
+    stDefDispRect.u32Height = 320;
+    stDefImageSize.u32Width = 240;
+    stDefImageSize.u32Height = 320;
+
+    s32Ret = SAMPLE_COMM_VO_GetDefConfig(stVoConfig);
+    if (s32Ret != CVI_SUCCESS)
+        return s32Ret;
+
+    stVoConfig->VoDev = VoDev;
+    stVoConfig->stVoPubAttr.enIntfType = VO_INTF_HW_MCU;
+    stVoConfig->stVoPubAttr.enIntfSync = VO_OUTPUT_USER;
+    stVoConfig->stVoPubAttr.stSyncInfo = st7789V3SyncInfo;
+    stVoConfig->stDispRect = stDefDispRect;
+    stVoConfig->stImageSize = stDefImageSize;
+    stVoConfig->enPixFormat = PIXEL_FORMAT_NV21;
+    stVoConfig->enVoMode = VO_MODE_1MUX;
+
+    return SAMPLE_COMM_VO_StartVO(stVoConfig);
+}
+
+static void SAMPLE_SML_VIO_HandleSig(CVI_S32 signo)
+{
+    signal(SIGINT, SIG_IGN);
+    signal(SIGTERM, SIG_IGN);
+    if (signo == SIGINT || signo == SIGTERM)
+        SAMPLE_PRT("Program termination abnormally\n");
+    exit(-1);
+}
+
+int main(int argc, char* argv[])
+{
+    CVI_S32 s32Ret;
+    VI_VPSS_MODE_E stViVpssMode = VI_OFFLINE_VPSS_ONLINE;
+    SAMPLE_VI_CONFIG_S stViConfig;
+    SNS_INI_CFG_S stSnsIniCfg;
+    VB_CONFIG_S stVbConfig;
+    SAMPLE_VO_CONFIG_S stVoConfig;
+    VO_DEV VoDev = 0;
+    VO_LAYER VoLayer = 0;
+    VO_CHN VoChn = 0;
+    int i;
+
+    (void)argc;
+    (void)argv;
+
+    signal(SIGINT, SAMPLE_SML_VIO_HandleSig);
+    signal(SIGTERM, SAMPLE_SML_VIO_HandleSig);
+
+    s32Ret = SAMPLE_SML_VIO_SYS_INIT(&stViConfig, &stSnsIniCfg, &stVbConfig);
+    if (s32Ret != CVI_SUCCESS)
+        return s32Ret;
+
+    s32Ret = SAMPLE_SML_VIO_SET_VI_VPSS_MODE(stViVpssMode);
+    if (s32Ret != CVI_SUCCESS)
+        goto exit_sys;
+
+    s32Ret = SAMPLE_SML_VIO_VI_INIT(&stViConfig);
+    if (s32Ret != CVI_SUCCESS)
+        goto exit_sys;
+
+    s32Ret = SAMPLE_SML_VIO_VPSS_INIT(&stViConfig);
+    if (s32Ret != CVI_SUCCESS)
+        goto exit_vi;
+
+    if (stViVpssMode == VI_OFFLINE_VPSS_OFFLINE || stViVpssMode == VI_ONLINE_VPSS_OFFLINE) {
+        for (i = 0; i < stViConfig.s32ViNum; i++)
+            SAMPLE_COMM_VI_Bind_VPSS(i, 0, i);
+    }
+
+    s32Ret = SAMPLE_SML_VIO_VO_INIT(&stVoConfig, VoDev);
+    if (s32Ret != CVI_SUCCESS)
+        goto exit_vpss;
+
+    s32Ret = CVI_VO_SetChnRotation(VoLayer, VoChn, ROTATION_90);
+    if (s32Ret != CVI_SUCCESS)
+        goto exit_vo;
+
+    s32Ret = SAMPLE_COMM_VPSS_Bind_VO(0, 1, VoLayer, VoChn);
+    if (s32Ret != CVI_SUCCESS)
+        goto exit_vo;
+
+    SAMPLE_PRT(
+        "sml_vio running: VPSS chn0=2560x1920, chn1=320x240, VO=240x320 rot90\n");
+    SAMPLE_SML_VIO_WAIT_EXIT();
+
+    SAMPLE_COMM_VPSS_UnBind_VO(0, 1, VoLayer, VoChn);
+
+exit_vo:
+    SAMPLE_COMM_VO_StopVO(&stVoConfig);
+
+exit_vpss:
+    if (stViVpssMode == VI_OFFLINE_VPSS_OFFLINE || stViVpssMode == VI_ONLINE_VPSS_OFFLINE) {
+        for (i = 0; i < stViConfig.s32ViNum; i++)
+            SAMPLE_COMM_VI_UnBind_VPSS(i, 0, i);
+    }
+
+    for (i = 0; i < stViConfig.s32ViNum; i++) {
+        CVI_VPSS_StopGrp(i);
+        CVI_VPSS_DisableChn(i, 0);
+        CVI_VPSS_DisableChn(i, 1);
+        CVI_VPSS_DestroyGrp(i);
+    }
+
+exit_vi:
+    SAMPLE_SML_VIO_VI_DEINIT(&stViConfig);
+
+exit_sys:
+    SAMPLE_COMM_SYS_Exit();
+
+    if (s32Ret == CVI_SUCCESS)
+        SAMPLE_PRT("sample_sml_vio exit success\n");
+    else
+        SAMPLE_PRT("sample_sml_vio exit abnormally, ret=%#x\n", s32Ret);
+
+    return s32Ret;
+}
-- 
