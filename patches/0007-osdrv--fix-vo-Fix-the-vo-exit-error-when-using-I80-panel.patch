Subject: [PATCH] [fix](vo):Fix the vo exit error when using I80 panel

[description]:NA
[root cause]:NA
[JIRA ID]:CV184XSDK-1139
[chip project]:CV184X
[side effects]:NA
[Affected *.ko/*.so/*.a] :NA

Change-Id: I60339acea859b3e9af7ff1018daeabbda6f920ea
---
 interdrv/vo/driver/vo_process.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/interdrv/vo/driver/vo_process.c b/interdrv/vo/driver/vo_process.c
index 7c05bbee..7cc7a4c4 100644
--- a/interdrv/vo/driver/vo_process.c
+++ b/interdrv/vo/driver/vo_process.c
@@ -915,7 +915,6 @@ int vo_stop_streaming(vo_dev dev)
 	dev_ctx = &g_vo_ctx->dev_ctx[dev];
 
 	disp_enable_window_bgcolor(dev, true);
-	disp_tgen_enable(dev, false);
 
 	osal_atomic_set(&dev_ctx->disp_streamon, 0);
 	TRACE_VO(DBG_INFO, "[dev%d]stop streaming.\n", dev);
@@ -923,5 +922,6 @@ int vo_stop_streaming(vo_dev dev)
 
 	osal_irq_free(dev_ctx->irq_num, (void *)dev_ctx);
 
+	disp_tgen_enable(dev, false);
 	return rc;
 }
